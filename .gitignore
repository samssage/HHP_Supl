# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.data/

!.env.example

/private-import/

# Department data is imported privately into Supabase, never published in Git.
/src/data/*.json
/data-source/
/supabase/seed.sql
/AGENTS.md
/CLAUDE.md
/SETUP.md

/scripts/import_inventory.py
/supabase/schema.sql
